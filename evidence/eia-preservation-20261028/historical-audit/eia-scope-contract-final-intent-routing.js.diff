+// Expose source positions for evidence validation without deciding request polarity.
+export function listRequestEvidenceMentions(query) {
+  const words = [...String(query).matchAll(/[\p{L}\p{N}]+|&/gu)];
+  let offset = 0;
+  const tokens = words.map(word => {
+    const text = normalizeText(word[0]);
+    const token = { text, index: offset, start: word.index, end: word.index + word[0].length };
+    offset += text.length + 1;
+    return token;
+  });
+  const normalized = tokens.map(t => t.text).join(" ");
+  const geoMatches = collectGeographyMatches(normalized, query);
+  const complete = geoMatches.filter(match => !geoMatches.some(other => other.length > match.length
+    && other.index <= match.index && other.index + other.length >= match.index + match.length));
+  const raw = [
+    ...complete.filter(m => !isRequestPronoun(normalized, m, query, complete)).map(m => ({ ...m, type: "geography", value: m.code })),
+    ...findConceptMentions(normalized),
+    ...FREQUENCY_RULES.flatMap(rule => rule.terms.flatMap(term => { const found = []; addPhraseMatch(found, normalized, term, { type: "frequency", value: rule.value }); return found; })),
+    ...SECTOR_RULES.flatMap(rule => rule.terms.flatMap(term => { const found = []; addPhraseMatch(found, normalized, term, { type: "sector", value: rule.value }); return found; }))
+  ];
+  return raw.map(m => {
+    const first = tokens.find(t => t.index === m.index);
+    const last = tokens.find(t => t.index + t.text.length === m.index + m.text.length);
+    return first && last ? { start: first.start, end: last.end, text: String(query).slice(first.start, last.end), type: m.type, value: m.value } : null;
+  }).filter(Boolean).filter((m, i, all) => all.findIndex(x => x.start === m.start && x.end === m.end && x.type === m.type && x.value === m.value) === i)
+    .sort((a, b) => a.start - b.start || b.end - a.end);
+}
