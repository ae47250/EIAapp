+// Derive input forms from complete official labels; never drop a geographic
+// qualifier. Only the grammatical article is optional. Canonical output stays unchanged.
+export function geographyNameForms(name) {
+  const text = String(name || "").trim();
+  const forms = [text];
+  const parts = text.split(",").map(part => part.trim());
+  if (parts.length === 2 && parts.every(Boolean)) {
+    forms.push(parts[1] + " " + parts[0]);
+    if (/^the$/i.test(parts[1])) forms.push(parts[0]);
+  }
+  if (/^the /i.test(text)) {
+    const noun = text.replace(/^the\s+/i, "");
+    forms.push(noun, noun + ", The");
+  }
+  return [...new Set(forms.filter(Boolean))];
+}
