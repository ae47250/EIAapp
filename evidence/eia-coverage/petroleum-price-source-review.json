  "findings": [
    {
      "source": "https://www.eia.gov/dnav/pet/TblDefs/pet_pri_gnd_tbldef2.asp",
      "finding": "Weekly retail gasoline/diesel prices include taxes. Monthly/annual values are published averages, not an app frequency conversion."
    },
    {
      "source": "https://www.eia.gov/dnav/pet/TblDefs/pet_pri_allmg_tbldef2.asp",
      "finding": "All-seller averages, refiner-only prices and sales channels differ. Grades/formulations are components of motor gasoline; aviation gasoline is excluded from motor gasoline."
    },
    {
      "source": "https://www.eia.gov/dnav/pet/TblDefs/pet_pri_dfp1_tbldef2.asp",
      "finding": "First purchase is the physical crude ownership-transfer price at lease/wellhead. Its U.S. scope includes offshore; offshore/state subdivisions are not whole states."
    },
    {
      "source": "https://www.eia.gov/dnav/pet/TblDefs/pet_pri_rac2_tbldef2.asp",
      "finding": "Composite refinery acquisition combines domestic/imported crude; prefer it over origin components within this basis. Its U.S. scope includes territories."
    },
    {
      "source": "https://www.eia.gov/dnav/pet/TblDefs/pet_move_land2_tbldef2.asp",
      "finding": "Imported crude means brought into the U.S.; FOB and landed bases differ in covered costs. Named foreign origins and crude streams are components, not foreign-country market prices."
    },
    {
      "source": "https://www.eia.gov/dnav/pet/pet_pri_allmg_a_epm0_pta_dpgal_m.htm",
      "finding": "Older all-seller gasoline tables show series ending in 2022. Historical existence does not establish current-year availability; live B1 periods still required."
    }
  ],
  "expectationsBeforeClassifierEdit": [
    "No price-route product is whole petroleum. Crude oil and motor gasoline can qualify only in their separate explicit-qualifier cells.",
    "All-grade/all-formulation motor gasoline retail price may be whole gasoline; regular/premium/formulation/aviation/other petroleum components cannot substitute.",
    "A price unit must remain prices even when process text says Retail Sales or route path says move.",
    "All-seller retail and wholesale totals are labelled alternative price bases; refiner-only/company-outlet/rack/bulk/DTW components require the corresponding broader total comparison.",
    "Residential/commercial/industrial sales prices keep sector scope; petrochemical and other-end-user groupings are not whole named sectors.",
    "U.S. total first-purchase, total FOB, total landed and composite refiner acquisition are distinct labelled crude-price bases. Crude grades, named streams, origins, and partial geographies remain narrower.",
    "Domestic/imported refinery acquisition are components of composite, not broader crude totals.",
    "Never map a foreign trade partner to subject-country prices; source first-purchase geography is different from refinery destination geography.",
    "Published native codes/full definitions and units must agree; unknown codes, altered source names and incompatible units stay pending.",
    "Preserve every source definition/frequency/provenance. No metadata classification is proof of published observations."
  ],
  "scopeCasesForCheckpoint": [
    {
      "case": "gasoline retail survey",
      "decision": "all grades/all formulations with tax label; narrower grades or sales populations remain components; preserve alternate seller-stage bases"
    },
    {
      "case": "crude first-purchase/refiner/import prices",
      "decision": "different transaction bases labelled separately; composite preferred to domestic/imported acquisition components; imports totals cover all origins, not one origin"
    },
    {
      "case": "refiner-only product prices",
      "decision": "broader all-seller series exist as metadata candidates; keep refiner-only prices narrower pending period-compatible B1 comparison"
    }
  ],
  "metadataIssues": [
    {
      "field": "Crude Gravity product names",
      "finding": "Some API facet names say percent; the full series and EIA source define degrees API. Retain originals; these grade components cannot become crude totals."
    }
  ]
