  "expectations": [
    {
      "id": "balance-components",
      "source": "https://www.eia.gov/dnav/pet/TblDefs/pet_sum_snd_tbldef2.asp",
      "quote": "The components of petroleum disposition are stock change, crude oil losses, refinery inputs, exports, and products supplied for domestic consumption.",
      "expected": "Stock change, net receipts, transfers, adjustments, utilization and days/percent ratios are not stock levels, gross trade, production or capacity."
    },
    {
      "id": "crude-demand",
      "source": "https://www.eia.gov/dnav/pet/TblDefs/pet_sum_sndw_tbldef2.asp",
      "quote": "For crude oil, refinery inputs of crude oil are used as a proxy for demand.",
      "expected": "Whole crude refinery inputs can be a labelled crude-consumption proxy only for explicit crude qualifier; never whole petroleum. Prefer broader compatible EIA measure if published. Other processing inputs cannot silently become whole consumption."
    },
    {
      "id": "net-production",
      "source": "https://www.eia.gov/dnav/pet/TblDefs/pet_pnp_refp_tbldef2.asp",
      "quote": "Published production of these products equals refinery production minus refinery input.",
      "expected": "Preserve net production and possible negative values. Total refinery-and-blender output is a labelled secondary-production basis; refinery-only/blender-only are components. It is not domestic primary extraction; compare compatible production bases without double counting."
    },
    {
      "id": "headline-total",
      "source": "https://www.eia.gov/dnav/pet/pet_pnp_refp_dc_nus_mbblpd_m.htm",
      "quote": "Refinery & Blender Net Production",
      "expected": "EP00 total has whole-product scope on the refinery-and-blender production basis, with scope label and broader-total preference. Field production and renewable-plant-only production do not replace all petroleum production."
    },
    {
      "id": "gasoline",
      "source": "https://www.eia.gov/dnav/pet/TblDefs/pet_pnp_wprodrb_tbldef2.asp",
      "quote": "Volumetric data on blending components, such as oxygenates, are not counted in data on finished motor gasoline until the blending components are blended into the gasoline.",
      "expected": "Finished gasoline total is the production/consumption basis; blendstocks and grades remain subsets. Compare refiner-only and blender-only with combined net output; no sum invented."
    },
    {
      "id": "capacity",
      "source": "https://www.eia.gov/dnav/pet/TblDefs/pet_pnp_unc_tbldef2.asp",
      "quote": "Operable capacity is the sum of the operating and idle capacity",
      "expected": "Operable capacity whole labelled refining basis; operating/idle narrower. Percent utilization is not capacity. Preserve native units and periods."
