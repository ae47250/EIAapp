# Existing application variables
EIA_API_KEY=<your-eia-api-key>
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=<your-openai-model>

# Server-only login variables. Use off only for the migration preview.
LOGIN_REQUIRED=on
APP_USERNAME=<your-login-username>
APP_PASSWORD_HASH=<generated-scrypt-hash>
SESSION_SECRET=<generated-random-secret>
